# Local development only. Copy to .env before Docker Compose startup.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=local-development-replace-before-any-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=parallel
POSTGRES_USER=parallel
POSTGRES_PASSWORD=parallel-local-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
