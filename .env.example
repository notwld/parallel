# Local development only. Copy to .env before Docker Compose startup.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=local-development-replace-before-any-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Explicit SPA origins for credentialed CORS (never *). Vite proxy remains preferred in local same-origin use.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=parallel
POSTGRES_USER=parallel
POSTGRES_PASSWORD=parallel-local-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0

# Email — leave EMAIL_BACKEND empty to auto-pick SMTP when EMAIL_HOST_PASSWORD is set, else console.
# Gmail: create an App Password at https://myaccount.google.com/apppasswords (not your login password).
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=parallel@localhost

# Optional one-shot bootstrap (manage.py bootstrap_superuser). Do not commit real values.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# OpenRouter is the chosen live vendor (D016). Leave the key empty to keep the fake provider.
# Live generation still waits on P019 typed validation. Do not paste this key into Git.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_MS=30000
LANGCHAIN_TRACING_V2=false
